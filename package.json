{
  "name": "aurelientondoux-website",
  "version": "0.0.0",
  "description": "Personal website of Aurélien Tondoux, built with Astro on the AstroWind template.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.2.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/partytown": "^2.1.9",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.43",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "astro-compress": "^2.4.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
