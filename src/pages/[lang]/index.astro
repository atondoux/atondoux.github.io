---
import type { GetStaticPaths } from 'astro';

import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Brands from '~/components/widgets/Brands.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Projects from '~/components/widgets/Projects.astro';
import Steps2 from '~/components/widgets/Steps2.astro';

import { locales } from '~/i18n/ui';
import { getCaseStudies } from '~/i18n/case-studies';
import { getCollaborationLogos } from '~/i18n/collaborations';
import { getContactCallToAction, getContactItems } from '~/i18n/contact';
import { getPricingPlans } from '~/i18n/pricing';
import { getServiceItems } from '~/i18n/services';
import { isLang, useTranslations } from '~/i18n/utils';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`Unsupported locale: ${lang}`);

const t = useTranslations(lang);

const emphasisClass = '[&_strong]:font-semibold [&_strong]:text-accent dark:[&_strong]:text-white';

const metadata = {
  title: t('home.title'),
  ignoreTitleTemplate: true,
  description: t('home.description'),
};
---

<PageLayout metadata={metadata}>
  <HeroText
    tagline={t('home.hero.tagline')}
    title={t('home.hero.title')}
    subtitle={t('home.hero.subtitle')}
    subtitleClass={emphasisClass}
  />
  <Features2
    id="about"
    title={t('home.about.title')}
    subtitle={t('home.about.subtitle')}
    classes={{ headline: { subtitle: `text-xl ${emphasisClass}` } }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
  <Brands
    id="collaborations"
    title={t('home.collaborations.title')}
    subtitle={t('home.collaborations.subtitle')}
    images={getCollaborationLogos(lang)}
    variant="marquee"
  />
  <Features2
    id="services"
    title={t('home.services.title')}
    subtitle={t('home.services.subtitle')}
    items={getServiceItems(lang)}
    columns={3}
    centerLastRow
  />
  <Pricing
    id="pricing"
    title={t('home.pricing.title')}
    subtitle={t('home.pricing.subtitle')}
    prices={getPricingPlans(lang)}
    currency=""
  />
  <Projects
    id="case-studies"
    title={t('home.caseStudies.title')}
    subtitle={t('home.caseStudies.subtitle')}
    items={getCaseStudies(lang)}
    columns={4}
  />
  <Steps2
    id="contact"
    title={t('home.contact.title')}
    subtitle={t('home.contact.subtitle')}
    items={getContactItems(lang)}
    callToAction={getContactCallToAction(lang)}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Steps2>
</PageLayout>
