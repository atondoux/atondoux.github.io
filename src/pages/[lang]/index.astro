---
import type { GetStaticPaths } from 'astro';

import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

import { locales } from '~/i18n/ui';
import { isLang, useTranslations } from '~/i18n/utils';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`Unsupported locale: ${lang}`);

const t = useTranslations(lang);

const metadata = {
  title: t('home.title'),
  ignoreTitleTemplate: true,
  description: t('home.description'),
};
---

<PageLayout metadata={metadata}>
  <HeroText
    tagline={t('home.hero.tagline')}
    title={t('home.hero.title')}
    subtitle={t('home.hero.subtitle')}
    subtitleClass="[&_strong]:font-semibold [&_strong]:text-accent dark:[&_strong]:text-white"
  />
</PageLayout>
