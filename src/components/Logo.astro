---
import { SITE } from 'astrowind:config';

import Image from '~/components/common/Image.astro';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white inline-flex items-center gap-2">
  <Image
    src="~/assets/images/avatar.jpeg"
    alt=""
    width={36}
    height={36}
    layout="fixed"
    loading="eager"
    class="w-9 h-9 md:w-8 md:h-8 rounded-full object-cover ring-1 ring-gray-200 dark:ring-slate-700"
  />
  {SITE?.name}
</span>
