{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist/",
    "legacy-nuxt/",
    "node_modules/",
    "playwright-report/",
    "test-results/",
    ".output/",
    ".nuxt/",
    ".data/"
  ]
}
